# Copy this file to .env and replace the development password.
POSTGRES_DB=damagemap
POSTGRES_USER=damagemap
POSTGRES_PASSWORD=replace-me

APP_PORT=8501
API_PORT=8000
POSTGRES_PORT=5432

# Development uses X-Reviewer-ID. Production will replace this with OIDC.
AUTH_MODE=development
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# The export worker writes pending feature or annotation changes at either threshold.
EXPORT_POLL_SECONDS=2
EXPORT_INTERVAL_SECONDS=300
EXPORT_EDIT_THRESHOLD=50
# Keep the current generated snapshot plus one rollback revision per stream.
EXPORT_REVISIONS_TO_KEEP=2

# Match these to the host account that owns bind-mounted files.
APP_UID=1000
APP_GID=1000
