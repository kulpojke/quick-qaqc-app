# Copy this file to .env and replace the development password.
POSTGRES_DB=damagemap
POSTGRES_USER=damagemap
POSTGRES_PASSWORD=replace-me

# Select the YAML relative to PROJECT_CONFIG_DIR; Compose requires this value.
PROJECT_CONFIG=camp_config.yaml
# Host directory mounted read-only at /project. Relative paths in YAML stay valid.
PROJECT_CONFIG_DIR=.

APP_PORT=8501
API_PORT=8000
POSTGRES_PORT=5432

# Development uses this reviewer unless X-Reviewer-ID overrides it.
AUTH_MODE=development
DEV_REVIEWER_ID=Pazazu
# Production uses AUTH_MODE=cloudflare with the Access team URL and audience.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# The export worker writes pending feature or annotation changes at either threshold.
EXPORT_POLL_SECONDS=2
EXPORT_INTERVAL_SECONDS=300
EXPORT_EDIT_THRESHOLD=50
# Keep the current generated snapshot plus one rollback revision per stream.
EXPORT_REVISIONS_TO_KEEP=2

# R2 S3 credentials for the export worker only. Bucket/endpoint/prefix live in YAML.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Match these to the host account that owns bind-mounted files.
APP_UID=1000
APP_GID=1000
